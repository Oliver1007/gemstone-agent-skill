# Local credentials; templates are safe only after review.
.env
.env.*
!.env.example
credentials/
secrets/
*.pem
*.key

# Dependencies, caches and generated build output
node_modules/
__pycache__/
*.py[cod]
.venv/
venv/
dist/
build/
coverage/
.cache/
logs/
*.log
.DS_Store
Thumbs.db
.idea/
.vscode/*.local.*

# Personal references / temporary research output
local-references/
tmp/
temp/
.staging/

# Deliberately do NOT blanket-ignore audit/, knowledge/, or staging/.
# Historical tracked files remain tracked even when a rule matches.
