{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gemstone-material-agent:schema:case-manifest:1.0.0",
  "type": "object",
  "required": ["schema_version", "case_id", "object_revision", "case_role", "verification_state", "current_pointers", "source_provenance"],
  "properties": {
    "schema_version": {"type": "string"},
    "case_id": {"type": "string"},
    "object_revision": {"type": "string"},
    "case_role": {"enum": ["ACTIVE_GENERALIZATION_CASE", "GOLDEN_SOURCE", "SYNTHETIC_FIXTURE", "HISTORICAL_REFERENCE"]},
    "verification_state": {"type": "string"},
    "current_pointers": {"type": "object"},
    "source_provenance": {"type": "array", "minItems": 1}
  },
  "additionalProperties": true
}
