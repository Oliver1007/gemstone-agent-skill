{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gemstone-material-agent:schema:knowledge-unit:1.1.0",
  "type": "object",
  "required": ["schema_version", "knowledge_id", "object_revision", "type", "claim", "claim_state", "scope", "provenance", "engine_dependency", "does_not_validate", "loading_level"],
  "properties": {
    "schema_version": {"type": "string"},
    "knowledge_id": {"type": "string"},
    "object_revision": {"type": "string"},
    "type": {"enum": ["GLOBAL_RULE", "FAMILY", "FEATURE", "FAILURE_MODE", "QA", "GOLDEN_COVERAGE"]},
    "claim": {"type": "string", "minLength": 1},
    "claim_state": {"$ref": "urn:gemstone-material-agent:schema:state-axes:1.0.0#/$defs/knowledge_claim_state"},
    "scope": {"type": "object", "minProperties": 1},
    "provenance": {"type": "array", "minItems": 1},
    "engine_dependency": {"type": "object"},
    "does_not_validate": {"type": "array"},
    "loading_level": {"enum": ["MANIFEST", "SUMMARY", "DECISION", "DEEP"]},
    "family_maturity": {"$ref": "urn:gemstone-material-agent:schema:state-axes:1.0.0#/$defs/family_knowledge_maturity"},
    "failure_validation_level": {"$ref": "urn:gemstone-material-agent:schema:state-axes:1.0.0#/$defs/failure_validation_level"},
    "case_finding_state": {"$ref": "urn:gemstone-material-agent:schema:state-axes:1.0.0#/$defs/case_finding_state"}
  },
  "additionalProperties": true
}
