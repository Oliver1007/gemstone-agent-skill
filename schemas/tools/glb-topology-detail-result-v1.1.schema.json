{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schema:glb-topology-detail-result:1.1.0",
  "title": "GLB Topology Detail Diagnostic Result V1.1",
  "type": "object",
  "required": ["schema_version", "diagnostic_id", "diagnostic_version", "read_only", "mutation_state", "accepted_as_evidence", "evidence_admission_status", "knowledge_impact", "input_identity", "diagnostic_identity", "definitions", "glb_structure", "primitives", "limitations"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "diagnostic_id": {"const": "diagnostic:glb-topology-detail-audit:v1.1"},
    "diagnostic_version": {"const": "1.1.0"},
    "read_only": {"const": true},
    "mutation_state": {"const": "NONE"},
    "accepted_as_evidence": {"const": false},
    "evidence_admission_status": {"const": "NOT_ADMITTED"},
    "knowledge_impact": {"const": "NONE"},
    "input_identity": {"type": "object", "required": ["artifact_id", "sha256", "bytes"], "properties": {"artifact_id": {"type": "string", "minLength": 1}, "sha256": {"pattern": "^[A-F0-9]{64}$"}, "bytes": {"type": "integer", "minimum": 1}}},
    "diagnostic_identity": {"type": "object", "required": ["source_locator", "source_sha256", "analysis_core_locator", "analysis_core_sha256", "output_schema"]},
    "definitions": {"type": "object"},
    "glb_structure": {"type": "object"},
    "primitives": {"type": "array", "minItems": 1},
    "limitations": {"type": "array", "minItems": 1}
  }
}
