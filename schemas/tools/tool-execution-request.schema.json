{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gemstone-material-agent:schema:tool-execution-request:1.0.0",
  "type": "object",
  "required": ["schema_version", "request_id", "authorization", "operation_id", "tool", "inputs", "output_locator"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "request_id": {"type": "string"},
    "authorization": {"const": "AUTH-4"},
    "operation_id": {"type": "string"},
    "tool": {
      "type": "object",
      "required": ["tool_id", "implementation_locator", "implementation_sha256", "adapter_locator", "adapter_sha256"],
      "properties": {
        "tool_id": {"type": "string"},
        "implementation_locator": {"type": "string"},
        "implementation_sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
        "adapter_locator": {"type": "string"},
        "adapter_sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"}
      }
    },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["artifact_id", "locator", "sha256"],
        "properties": {
          "artifact_id": {"type": "string"},
          "locator": {"type": "string"},
          "sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"}
        }
      }
    },
    "output_locator": {"type": "string"}
  },
  "additionalProperties": false
}
