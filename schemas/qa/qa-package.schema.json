{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gemstone-material-agent:schema:qa-package:1.0.0",
  "type": "object",
  "required": ["schema_version", "qa_package_id", "object_revision", "candidate_ref", "snapshot_ref", "engine_behavior_ref", "protocol_refs", "gates", "mutation_allowed"],
  "properties": {
    "schema_version": {"type": "string"},
    "qa_package_id": {"type": "string"},
    "object_revision": {"type": "string"},
    "candidate_ref": {"type": "string"},
    "snapshot_ref": {"type": "string"},
    "engine_behavior_ref": {"type": "string"},
    "protocol_refs": {"type": "array", "minItems": 1},
    "gates": {"type": "array", "minItems": 1},
    "mutation_allowed": {"const": false}
  },
  "additionalProperties": true
}
