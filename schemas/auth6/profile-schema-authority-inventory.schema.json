{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gemstone-material-agent:schema:profile-schema-authority-inventory:1.0.0",
  "type": "object",
  "required": ["schema_version", "inventory_id", "case_id", "sources", "authority_chain", "authority_result", "conflicts"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "inventory_id": {"type": "string"},
    "case_id": {"const": "case:citrine"},
    "sources": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["source_id", "type", "ref", "sha256", "status", "authority_claim", "scope", "superseded", "conflict", "usable", "result"], "additionalProperties": false}},
    "authority_chain": {"type": "array", "minItems": 1},
    "authority_result": {"enum": ["EXISTING_AUTHORITATIVE_SCHEMA", "COMPOSITE_VIEW_OF_EXISTING_AUTHORITY", "NONAUTHORITATIVE_SCHEMA_PROPOSAL", "UNRESOLVED", "CONFLICTED"]},
    "conflicts": {"type": "array"}
  },
  "additionalProperties": false
}
