{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gemstone-material-agent:schema:human-field-decision-packet:1.0.0",
  "type": "object",
  "required": ["schema_version", "packet_id", "case_id", "status", "decisions", "authority_effect", "raw_source_review_required"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "packet_id": {"type": "string"},
    "case_id": {"const": "case:citrine"},
    "status": {"const": "HUMAN_FIELD_DECISION_REQUIRED"},
    "decisions": {"type": "array", "minItems": 1},
    "authority_effect": {"type": "string"},
    "raw_source_review_required": {"const": false}
  },
  "additionalProperties": false
}
