{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gemstone-material-agent:schema:auth6:human-thickness-value-authority:1.0.0",
  "title": "Human Thickness Value Authority Event",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "record_id", "event_type", "wave", "case_id", "atomic_single", "materialization_attempt", "event", "result"],
  "properties": {
    "schema_version": {"const":"1.0.0"},
    "record_id": {"type":"string","minLength":1},
    "event_type": {"const":"HUMAN_PROFILE_INPUT_VALUE_AUTHORITY"},
