      "properties": {
        "authority_event_id":{"const":"authority-event:citrine:material-volume-thickness:wave-4.3i"},
        "human_authorization_ref":{"type":"object"},
        "schema":{"type":"object"},
        "field_id":{"const":"material.volume.thickness"},
        "authorized_value":{"const":0.0002},
        "canonical_unit":{"const":"METRE_ENGINE_WORLD_LENGTH"},
        "value_representation":{"const":"DECIMAL_METRE_ENGINE_WORLD_LENGTH"},
        "display_equivalent":{"type":"object"},
        "approximation_disposition":{"type":"object"},
        "authority_effective_utc":{"type":"string","format":"date-time"},
        "authority_basis":{"const":"EXPLICIT_CURRENT_HUMAN_THICKNESS_VALUE_DECISION"},
        "historical_profile_value_authority":{"const":"NOT_CLAIMED"},
        "historical_provenance_change":{"const":"NONE"},
        "authoritative_derivation_rule":{"const":"NOT_FOUND"},
        "physical_thickness_claim":{"const":"NONE"},
        "geometry_derived_truth":{"const":"NOT_CLAIMED"},
        "future_use_scope":{"const":"FUTURE_CITRINE_PROFILE_INPUT_ONLY"},
        "current_engine_mapping":{"const":"PARTIAL"},
        "current_engine_revalidation":{"const":"REQUIRED"},
        "range_validation":{"const":"NOT_PERFORMED"},
        "validated_range":{"type":"null"},
        "profile_creation_authority":{"const":false},
        "case_binding_authority":{"const":false},
        "auth6_authority":{"const":false},
        "lineage":{"type":"array","minItems":5,"items":{"type":"string","minLength":1}}
      }
