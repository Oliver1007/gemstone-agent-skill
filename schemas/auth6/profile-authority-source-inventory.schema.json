{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gemstone-material-agent:schema:profile-authority-source-inventory:1.0.0",
  "type": "object",
  "required": ["schema_version", "inventory_id", "case_id", "authoritative_profile_count", "sources", "counts", "result"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "inventory_id": {"type": "string"},
    "case_id": {"const": "case:citrine"},
    "authoritative_profile_count": {"const": 0},
    "sources": {"type": "array", "minItems": 1},
    "counts": {"type": "object"},
    "result": {"enum": ["PROFILE_AUTHORITY_SOURCE_RESOLVED", "PROFILE_AUTHORITY_MAPPED_WITH_BLOCKERS", "PROFILE_SOURCE_CONFLICT", "PROFILE_PROVENANCE_INSUFFICIENT"]}
  },
  "additionalProperties": true
}
