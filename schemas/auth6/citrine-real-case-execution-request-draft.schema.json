{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gemstone-material-agent:schema:citrine-real-case-execution-request-draft:1.0.0",
  "type": "object",
  "required": ["schema_version", "request_id", "status", "human_case_selection", "case_id", "task_mode", "start_phase", "current_candidate_ref", "candidate_creation_policy", "profile_ref", "reference_ref", "run_context_ref", "frozen_scope_ref", "engine_behavior_ref", "tool_refs", "renderer_ref", "allowed_mutation_domains", "forbidden_mutation_domains", "execution_budget", "retry_budget", "expected_write_set", "render_plan", "qa_plan", "regression_plan", "rollback", "certification_ceiling", "required_future_human_approval", "candidate_activation", "profile_update", "executable"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "request_id": {"type": "string"},
    "status": {"const": "DRAFT"},
    "human_case_selection": {"const": "CITRINE"},
    "case_id": {"const": "case:citrine"},
    "task_mode": {"const": "GENERALIZATION_CASE"},
    "start_phase": {"const": "P6"},
    "current_candidate_ref": {"type": "null"},
    "candidate_creation_policy": {"const": "CREATE_NEW_CANDIDATE_ONLY"},
    "profile_ref": {"type": "null"},
    "reference_ref": {"const": "reference-set:citrine:yellow-reference:v1"},
    "run_context_ref": {"type": "null"},
    "frozen_scope_ref": {"type": "string"},
    "engine_behavior_ref": {"type": "object", "required": ["citrine_current", "future_candidate", "compatibility"]},
    "tool_refs": {"type": "array", "minItems": 1},
    "renderer_ref": {"type": "string"},
    "allowed_mutation_domains": {"type": "array"},
    "forbidden_mutation_domains": {"type": "array", "minItems": 1},
    "execution_budget": {"const": "HUMAN_AUTHORIZATION_REQUIRED_FOR_BUDGET"},
    "retry_budget": {"const": "HUMAN_AUTHORIZATION_REQUIRED_FOR_BUDGET"},
    "expected_write_set": {"type": "array", "maxItems": 0},
    "render_plan": {"type": "object"},
    "qa_plan": {"type": "object"},
    "regression_plan": {"type": "object"},
    "rollback": {"type": "object"},
    "certification_ceiling": {"const": "CANDIDATE_ONLY_NO_P10_P11_GOLDEN_OR_PROFILE_EFFECT"},
    "required_future_human_approval": {"const": true},
    "candidate_activation": {"const": false},
    "profile_update": {"const": false},
    "executable": {"const": false}
  },
  "additionalProperties": false
}
