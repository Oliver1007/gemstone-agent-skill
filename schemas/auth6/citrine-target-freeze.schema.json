{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gemstone-material-agent:schema:citrine-target-freeze:1.0.0",
  "type": "object",
  "required": ["schema_version", "target_selection_id", "human_selection", "case_id", "case_record", "task_mode", "phase", "current_candidate_ref", "profile_ref", "reference_ref", "run_context_ref", "frozen_scope_ref", "engine_behavior_ref", "selection_timestamp", "authority_ceiling", "limitations", "authorizes_auth6_execution"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "target_selection_id": {"type": "string"},
    "human_selection": {"const": "CITRINE"},
    "case_id": {"const": "case:citrine"},
    "case_record": {"type": "object", "required": ["manifest_ref", "manifest_sha256", "state_ref", "state_sha256", "object_revision"]},
    "task_mode": {"const": "GENERALIZATION_CASE"},
    "phase": {"const": "P6"},
    "current_candidate_ref": {"type": "null"},
    "profile_ref": {"type": "null"},
    "reference_ref": {"const": "reference-set:citrine:yellow-reference:v1"},
    "run_context_ref": {"type": "null"},
    "frozen_scope_ref": {"type": "string"},
    "engine_behavior_ref": {"type": "null"},
    "selection_timestamp": {"type": "string"},
    "authority_ceiling": {"const": "TARGET_SELECTION_ONLY_NO_AUTH6_EXECUTION"},
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "authorizes_auth6_execution": {"const": false}
  },
  "additionalProperties": false
}
