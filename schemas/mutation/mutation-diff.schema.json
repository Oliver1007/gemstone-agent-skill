{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gemstone-material-agent:schema:mutation-diff:1.0.0",
  "type": "object",
  "required": ["schema_version", "diff_id", "request_ref", "items"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "diff_id": {"type": "string"},
    "request_ref": {"type": "string"},
    "items": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["relative_path", "change_type", "before_state", "after_sha256", "after_byte_size"],
        "properties": {
          "relative_path": {"type": "string"},
          "change_type": {"const": "CREATE"},
          "before_state": {"const": "ABSENT"},
          "after_sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
          "after_byte_size": {"type": "integer", "minimum": 1}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
