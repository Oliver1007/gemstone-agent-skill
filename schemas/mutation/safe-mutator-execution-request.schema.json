{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gemstone-material-agent:schema:safe-mutator-execution-request:1.0.0",
  "type": "object",
  "required": ["schema_version", "request_id", "pilot_mode", "operation_id", "source_identity", "authorization", "argv", "working_directory", "expected_outputs", "target", "filesystem_assertions", "semantic_assertions"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "request_id": {"type": "string"},
    "pilot_mode": {"enum": ["EXISTING_MUTATOR_ASSESSMENT", "SYNTHETIC_MOCK"]},
    "operation_id": {"type": "string"},
    "source_identity": {
      "type": "object",
      "required": ["locator", "sha256"],
      "properties": {"locator": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"}},
      "additionalProperties": false
    },
    "authorization": {
      "type": "object",
      "required": ["required_level", "state"],
      "properties": {"required_level": {"const": "AUTH-5"}, "state": {"const": "NOT_GRANTED_STATIC_ONLY"}},
      "additionalProperties": false
    },
    "argv": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "working_directory": {"type": "string"},
    "expected_outputs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "target": {
      "type": "object",
      "required": ["case_ref", "candidate_id", "staging_root", "final_root"],
      "properties": {"case_ref": {"type": "string"}, "candidate_id": {"type": "string"}, "staging_root": {"type": "string"}, "final_root": {"type": "string"}},
      "additionalProperties": false
    },
    "filesystem_assertions": {
      "type": "object",
      "required": ["target_exists", "staging_volume_id", "final_volume_id", "staging_empty", "links_present"],
      "properties": {"target_exists": {"type": "boolean"}, "staging_volume_id": {"type": "string"}, "final_volume_id": {"type": "string"}, "staging_empty": {"type": "boolean"}, "links_present": {"type": "boolean"}},
      "additionalProperties": false
    },
    "semantic_assertions": {
      "type": "object",
      "required": ["case_profile_externalized", "fallback_disabled", "artistic_inclusions_declared", "frozen_domains_clear"],
      "properties": {"case_profile_externalized": {"type": "boolean"}, "fallback_disabled": {"type": "boolean"}, "artistic_inclusions_declared": {"type": "boolean"}, "frozen_domains_clear": {"type": "boolean"}},
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
