{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gemstone-material-agent:schema:write-set:1.0.0",
  "type": "object",
  "required": ["schema_version", "write_set_id", "request_ref", "target_root", "mode", "allow_symlinks", "allow_reparse_points", "maximum_files", "maximum_total_bytes", "files"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "write_set_id": {"type": "string"},
    "request_ref": {"type": "string"},
    "target_root": {"type": "string"},
    "mode": {"const": "CREATE_ONLY"},
    "allow_symlinks": {"const": false},
    "allow_reparse_points": {"const": false},
    "maximum_files": {"type": "integer", "minimum": 1},
    "maximum_total_bytes": {"type": "integer", "minimum": 1},
    "files": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["relative_path", "expected_state", "write_mode"],
        "properties": {
          "relative_path": {"type": "string"},
          "expected_state": {"const": "ABSENT"},
          "write_mode": {"const": "CREATE_NEW"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
