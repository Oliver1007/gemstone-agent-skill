{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gemstone-material-agent:schema:capability-source-map:1.0.0",
  "type": "object",
  "required": ["schema_version", "capability_map_id", "object_revision", "authority_role", "engine_behavior_ref", "entries"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "capability_map_id": {"type": "string"},
    "object_revision": {"type": "string"},
    "authority_role": {"const": "SKILL_SIDE_SOURCE_OBSERVATION_NOT_ENGINE_DECLARATION"},
    "engine_behavior_ref": {"type": "string"},
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["capability_id", "mechanism", "availability", "accepted_range", "validated_range", "engine_module_maturity", "execution_validation_state", "source_evidence", "known_limitations"],
        "properties": {
          "capability_id": {"type": "string"},
          "mechanism": {"type": "string"},
          "availability": {"enum": ["AVAILABLE_SOURCE_DISCOVERED", "UNKNOWN", "NOT_DISCOVERED"]},
          "accepted_range": {},
          "validated_range": {},
          "engine_module_maturity": {"$ref": "urn:gemstone-material-agent:schema:state-axes:1.0.0#/$defs/engine_module_maturity"},
          "execution_validation_state": {"const": "NOT_EXECUTED"},
          "source_evidence": {"type": "array", "minItems": 1},
          "known_limitations": {"type": "array"}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
